    "@pravoletter/schemas": "workspace:*",
    "@aws-sdk/client-s3": "^3.645.0",
    "pg-boss": "^10.1.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
