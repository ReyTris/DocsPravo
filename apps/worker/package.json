    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg-boss": "^10.1.5",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.4",
