{
  "name": "@pravoletter/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pravoletter/core": "workspace:*",
