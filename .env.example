# ============ Общее ============
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# ============ База данных ============
# В проде — Yandex Managed PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pravoletter

# ============ Auth ============
# openssl rand -base64 32
AUTH_SECRET=
JWT_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# ============ Object Storage (Yandex) ============
OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
OBJECT_STORAGE_REGION=ru-central1
OBJECT_STORAGE_BUCKET=pravoletter-uploads
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ============ LLM ============
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# OpenAI — только для разработки на синтетике, НЕ для прода с реальными ПД
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============ OCR ============
YANDEX_VISION_API_KEY=
YANDEX_VISION_FOLDER_ID=

# ============ ЮKassa ============
UKASSA_SHOP_ID=
UKASSA_SECRET_KEY=
UKASSA_WEBHOOK_SECRET=

# ============ SMTP (Unisender Go / Yandex 360) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@pravoletter.ru

# ============ Telegram bot ============
TELEGRAM_BOT_TOKEN=
